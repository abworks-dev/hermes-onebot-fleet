# Put real values only in the target profile's .env. These are NOT usable tokens.
ONEBOT_FLEET_PRIMARY_TOKEN=REPLACE_WITH_RANDOM_PRIMARY_TOKEN
ONEBOT_FLEET_STANDBY_TOKEN=REPLACE_WITH_DIFFERENT_RANDOM_STANDBY_TOKEN
# Hermes gateway admission is a second independent check. Match allowed_users.
ONEBOT_FLEET_ALLOWED_USERS=20001
# Optional native notification/cron target; logical_id must match configuration.
ONEBOT_FLEET_HOME_CHANNEL=obf:onebot-fleet:private:20001
